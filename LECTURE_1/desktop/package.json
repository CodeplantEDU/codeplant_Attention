{
  "name": "codeplant-attention-desktop",
  "productName": "CODEPLANT ATTENTION",
  "version": "0.6.2",
  "description": "AI 대화 스튜디오 · 개인 계정으로 사용하는 데스크톱 앱",
  "author": "CODEPLANT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "prepare:node": "node scripts/prepare-node.mjs",
    "test": "node --test tests/*.test.mjs",
    "pack:win": "electron-builder --win portable --x64 --publish never",
    "pack:mac": "electron-builder --mac dmg --universal --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.codeplant.attention",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["main.mjs", "auth.mjs", "runtime.mjs", "smoke.mjs", "setup.html", "setup.js", "preload.cjs", "package.json"],
    "extraResources": [
      {"from": "../site", "to": "site", "filter": ["server.mjs", "lib/**", "tools/gemini-auth.mjs", "public/**"]},
      {"from": "worker.mjs", "to": "worker.mjs"},
      {"from": "runtime", "to": "runtime"}
    ],
    "win": {"target": "portable", "artifactName": "CODEPLANT-ATTENTION-Windows.exe", "signAndEditExecutable": false},
    "portable": {"requestExecutionLevel": "user"},
    "mac": {"target": "dmg", "artifactName": "CODEPLANT-ATTENTION-Mac.dmg", "category": "public.app-category.productivity", "identity": null, "hardenedRuntime": false, "mergeASARs": true, "x64ArchFiles": "Contents/Resources/runtime/**"},
    "dmg": {"title": "CODEPLANT ATTENTION"},
    "publish": null
  }
}
